<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>fr.black_eyes.lootchest</groupId>
    <artifactId>LootChest</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <modules>
        <module>lootchest</module>
    </modules>
    <name>LootChest</name>
    <description>Create higly customizable lootboxes for your minecraft server</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <release>25</release>
        <source>25</source>
        <target>25</target>
        <maven.compiler.release>25</maven.compiler.release>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <revision>2.5.9.3</revision>
        <buildNumber>231</buildNumber>
        <paperVersion>26.3</paperVersion>
        <paperBuild>241</paperBuild>
        <paperChannel>STABLE</paperChannel>
        <paperApiVersion>26.3.build.241-stable</paperApiVersion>
        <paperSha256>ea1081663127a4256ca8ce500899a44b896c3a834a8bfac65d1e58ee1f1bee13</paperSha256>
        <cmiApiVersion>9.8.6.4</cmiApiVersion>
        <cmiLibApiVersion>1.5.9.6</cmiLibApiVersion>
        <cmiTestedVersion>9.8.11.0</cmiTestedVersion>
        <cmiLibTestedVersion>1.6.1.0</cmiLibTestedVersion>
        <junitVersion>6.0.3</junitVersion>
        <lombokVersion>1.18.46</lombokVersion>
    </properties>
    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <release>25</release>
                        <source>25</source>
                        <target>25</target>
                        <testRelease>25</testRelease>
                        <testSource>25</testSource>
                        <testTarget>25</testTarget>
                        <compilerId>javac</compilerId>
                        <fork>true</fork>
                        <jdkToolchain>
                            <version>25</version>
                            <vendor>Oracle Corporation</vendor>
                        </jdkToolchain>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <showDeprecation>true</showDeprecation>
                        <showWarnings>true</showWarnings>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <jdkToolchain>
                            <version>27</version>
                            <vendor>Oracle Corporation</vendor>
                        </jdkToolchain>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <failIfNoTests>true</failIfNoTests>
                        <environmentVariables>
                            <JAVA_HOME>${env.ONE_MB_TEST_JAVA_HOME}</JAVA_HOME>
                            <PATH>${env.ONE_MB_TEST_JAVA_HOME}/bin:${env.PATH}</PATH>
                        </environmentVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.4</version>
                    <configuration>
                        <jdkToolchain>
                            <version>27</version>
                            <vendor>Oracle Corporation</vendor>
                        </jdkToolchain>
                        <forkCount>1</forkCount>
                        <reuseForks>true</reuseForks>
                        <failIfNoTests>true</failIfNoTests>
                        <environmentVariables>
                            <JAVA_HOME>${env.ONE_MB_TEST_JAVA_HOME}</JAVA_HOME>
                            <PATH>${env.ONE_MB_TEST_JAVA_HOME}/bin:${env.PATH}</PATH>
                        </environmentVariables>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <id>require-validated-local-jdks</id>
                        <phase>validate</phase>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireEnvironmentVariable>
                                    <variableName>LOOTCHEST_TOOLCHAINS_VALIDATED</variableName>
                                    <regex>1</regex>
                                    <message>Use ./mvnw: it validates installed Oracle JDKs 25 and 27 before Maven starts.</message>
                                </requireEnvironmentVariable>
                                <requireJavaVersion><version>[25,26)</version></requireJavaVersion>
                                <requireJavaVendor><includes><include>Oracle Corporation</include></includes></requireJavaVendor>
                                <requireProperty>
                                    <property>java.home</property>
                                    <regex>\Q${env.ONE_MB_BUILD_JAVA_HOME}\E</regex>
                                    <message>Maven must use the validated Oracle 25 home. Run ./mvnw.</message>
                                </requireProperty>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.6.0</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
